{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"useTabs": true,
	"markdown": {},
	"toml": {},
	"typescript": {
		"semiColons": "asi",
		"quoteStyle": "preferSingle"
	},
	"markup": {
		"quotes": "single",
		"svelte.scriptIndent": true,
		"svelte.styleIndent": true
	},
	"yaml": {},
	"json": {
		"trailingCommas": "maintain"
	},
	"exec": {
		"commands": [{
			"command": "bunx @surrealdb/surql-fmt --stdin --indent-char tab --indent 1",
			"exts": ["surql"]
		}]
	},
	"excludes": [
		"**/node_modules",
		"**/*-lock.json",
		"**/dist",
		"**/target",
		"*.min.js",
		"**/*.surql"
	],
	"plugins": [
		"npm:@dprint/typescript@0.96.1",
		"npm:@dprint/json@0.23.0",
		"npm:@dprint/markdown@0.23.2",
		"npm:@dprint/toml@0.8.0",
		"npm:@dprint/oxc@0.37.0",
		"npm:dprint-plugin-malva@0.16.0",
		"npm:dprint-plugin-markup@0.27.3",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
	]
}
